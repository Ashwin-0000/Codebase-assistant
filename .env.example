# ============================================================
# CodeRAG — environment configuration template
# Copy this file to .env and fill in the values you need.
# All settings have sensible defaults for local/offline use.
# ============================================================

# ----------------------------------------------------------
# EMBEDDING MODEL
# ----------------------------------------------------------
# Provider: "sentence_transformers" (default, no API key needed)
#           "openai" | "voyage" | "cohere"
CODERAG_EMBEDDING_PROVIDER=sentence_transformers

# Model name within the provider
CODERAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----------------------------------------------------------
# LLM FOR GENERATION
# ----------------------------------------------------------
# Provider: "openai" | "anthropic" | "ollama" (local)
CODERAG_LLM_PROVIDER=openai

# Model name within the provider
CODERAG_LLM_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# API KEYS (only needed for the providers you select above)
# ----------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# Ollama base URL (if CODERAG_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ----------------------------------------------------------
# VECTOR STORE
# ----------------------------------------------------------
# Provider: "chroma" (default, local) | "qdrant" | "pgvector"
CODERAG_VECTOR_STORE=chroma

# Directory where Chroma persists data
CODERAG_CHROMA_PATH=.coderag/chroma

# ----------------------------------------------------------
# INDEXING BEHAVIOUR
# ----------------------------------------------------------
# Maximum tokens per chunk (soft limit; long functions are split)
CODERAG_CHUNK_MAX_TOKENS=512

# Overlap tokens when splitting long functions
CODERAG_CHUNK_OVERLAP_TOKENS=64

# Languages to parse (comma-separated)
CODERAG_LANGUAGES=python,javascript,typescript

# Skip LLM-based docstring generation for undocumented functions?
# Set to "true" to avoid API calls during indexing
CODERAG_SKIP_DOCGEN=false

# ----------------------------------------------------------
# RETRIEVAL BEHAVIOUR
# ----------------------------------------------------------
# Number of initial similarity results
CODERAG_TOP_K=8

# Call-graph expansion depth (0 = no expansion)
CODERAG_GRAPH_EXPANSION_DEPTH=1

# Token budget for the final context window sent to the LLM
CODERAG_CONTEXT_TOKEN_BUDGET=8000

# Enable cross-encoder re-ranking? (requires additional dependencies)
CODERAG_RERANKING_ENABLED=false
CODERAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ----------------------------------------------------------
# LOGGING
# ----------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
CODERAG_LOG_LEVEL=INFO

# Optional log file path (leave empty to log to stdout only)
CODERAG_LOG_FILE=
